# Consolidation SEO du 01/09/2026 : les pages index par podcast
# (questions/<slug>/index.html) etaient du thin content a l'echelle du site
# (nombreuses fiches N1 classees "Detectee, non indexee" par Google Search
# Console). Elles sont remplacees par un bloc "Questions couvertes" injecte
# directement dans la fiche N1 correspondante, qui devient le hub complet du
# podcast. Cette regle redirige (301) toute ancienne URL index deja
# decouverte/indexee par Google vers la fiche N1, pour transferer son
# autorite au lieu de la perdre (evite les 404 sur des URLs deja crawlees).
RewriteEngine On
RewriteRule ^questions/([^/]+)/index\.html$ /podcast-btb/$1-podcast.html [R=301,L]

# Ajout du 08/09/2026 : meme logique pour les anciennes pages index par episode
# (episodes/<slug>/index.html) -- confirme comme thin content (~50-60 mots) via le
# croisement avec l'export Search Console (24 de ces pages faisaient partie des 625
# URLs "Detectee, non indexee"). Redirige vers la fiche N1 correspondante (meme casse
# de slug verifiee sur un cas reel : Nos-epaules-et-vos-ailes).
RewriteRule ^episodes/([^/]+)/index\.html$ /podcast-btb/$1-podcast.html [R=301,L]

# Ajout du 08/09/2026 : noindex,follow sur les 40 pages categorie confirmees fines
# (<200 mots, seuil determine sur la vraie repartition des 50 pages -- rupture nette
# entre 191 et 2155 mots pour les 10 gardees, vs 49 a 191 pour ces 40). Contrairement
# aux pages index ci-dessus, pas de cible de redirection unique evidente (plusieurs
# podcasts differents par page) -- on les laisse accessibles (follow, le maillage
# reste utile) mais on dit explicitement a Google de ne pas les indexer, plutot que de
# compter sur leur seule absence du sitemap (signal trop faible : confirme par le
# croisement Search Console, 22 de ces 40 pages etaient deja dans le lot des 625
# URLs bloquees "Detectee, non indexee").
<FilesMatch "^(business|business-investing-gestion-de-patrimoine|business-transformation-it|construction-infrastructure|developpement-personnel-leadership|droit|droit-business-juridique|droit-juridique|e-commerce-retail|entrepreneuriat-creation|expertise-comptable-management|finance-banque|finance-conformite|finance-entrepreneuriat|finance-gestion-d-actifs|finance-investissement|formation-professionnelle|general|geopolitique-affaires|gestion-de-patrimoine|immobilier-habitat|immobilier-leadership|impact-social-finance-responsable|innovation-financement-b2b|intelligence-artificielle-data|management-rh|marketing|recherche-management|ressources-humaines|risk-management-conformite-b2b|rse-developpement-durable|rse-leadership|sante-bien-etre|sante-medecine|sante-societe|societe-foi|societe-identite|societe-personnalites|technologie-business|technology-business)\.html$">
  Header set X-Robots-Tag "noindex, follow"
</FilesMatch>

# Ajout du 24/09/2026 : le podcast "De la cave au grenier" existait en double
# (slug aleatoire ogd6etwxpdgr + slug de-la-cave-au-grenier, meme flux RSS).
# Google a refuse la copie ("Exploree, actuellement non indexee"). Le doublon est
# supprime et redirige vers la fiche conservee.
RewriteRule ^ogd6etwxpdgr-podcast\.html$ /podcast-btb/de-la-cave-au-grenier-podcast.html [R=301,L]

# Ajout du 24/09/2026 : le slug "the retreat leaders podcast" contenait des espaces
# (URLs en %20, canonique non conforme a l'URL exploree). Renomme en
# the-retreat-leaders-podcast ; les anciennes URLs redirigent vers les nouvelles.
RewriteRule ^the\s+retreat\s+leaders\s+podcast-podcast\.html$ /podcast-btb/the-retreat-leaders-podcast-podcast.html [R=301,L]
RewriteRule ^questions/the\s+retreat\s+leaders\s+podcast/(.*)$ /podcast-btb/questions/the-retreat-leaders-podcast/$1 [R=301,L]

# BEGIN hub-consolidation (genere par hub_consolidation.py)
