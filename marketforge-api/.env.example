# Clé API Anthropic (console.anthropic.com). Ne jamais la commiter.
ANTHROPIC_API_KEY=
# Dossier des fichiers JSON clients. Sur Railway : monter un Volume sur /app/data.
DATA_DIR=/app/data
# Optionnel : modèle utilisé pour l'extraction (défaut : claude-opus-5)
# CLAUDE_MODEL=claude-opus-5
# Optionnel : origines autorisées (CORS), séparées par des virgules
# CORS_ORIGINS=https://marketforge.fr,https://www.marketforge.fr
