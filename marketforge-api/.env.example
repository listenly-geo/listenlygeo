# Token GitHub fine-grained sur listenly-geo/listenlygeo :
#   Actions = Read and write, Contents = Read-only. Ne jamais le commiter.
GITHUB_TOKEN=
# Dossier des fichiers JSON clients. Sur Railway : monter un Volume sur /app/data.
DATA_DIR=/app/data

# Optionnels (valeurs par défaut indiquées)
# GITHUB_REPO=listenly-geo/listenlygeo
# WORKFLOW_FILE=marketforge-hub.yml
# FICHES_PER_RUN=3            # fiches question générées par analyse
# MIN_HOURS_BETWEEN_RUNS=12   # un client ne peut relancer qu'une analyse toutes les 12 h
# MAX_RUNS_PER_DAY=10         # plafond global d'analyses par jour (contrôle de coût)
# CORS_ORIGINS=https://marketforge.fr,https://www.marketforge.fr

# --- Connexion (recommandé) : valeurs publiques du projet Supabase utilisé par Bolt
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# --- Paiement Stripe (active le paiement dès que STRIPE_SECRET_KEY est défini)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...           # endpoint : https://<api>/api/billing/webhook
# STRIPE_PRICES={"starter":"price_...","pro":"price_..."}
# PLAN_FICHES={"starter":3,"pro":5}         # fiches générées par analyse selon le plan
# FREE_RUNS=1                               # analyses gratuites avant abonnement
# APP_URL=https://marketforge.fr

# --- Administration (pause générale depuis /app/admin)
# ADMIN_KEY=une-longue-phrase-secrete     # à saisir dans la page Administration du dashboard
# ADMIN_EMAILS=admin@marketforge.fr       # emails autorisés quand la connexion Supabase est active
